					</Properties>
					<Action><![CDATA[int d = getDayOfWeek();
if (d != SATURDAY && d != SUNDAY && randomTrue(pDiaPolimento))
    sourcePolimento.inject(1);]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1785886850871</Id>
					<Name><![CDATA[configurarLavadores]]></Name>
					<X>830</X><Y>600</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double[][] p = {
    {3.066, 0.218, 2.467, 0.258},
    {3.657, 0.201, 2.995, 0.253},
    {3.708, 0.202, 3.132, 0.251},
    {3.821, 0.227, 3.177, 0.250},
    {3.853, 0.208, 3.230, 0.246},
    {3.870, 0.218, 3.255, 0.237},
    {3.945, 0.218, 3.304, 0.269},
    {4.415, 0.229, 3.761, 0.290},
    {4.480, 0.233, 3.892, 0.261}
};
String[] nomes = {"Val","Edson","Marcao","Douglas","Jaqueline",
                  "Moacir","Railson","Kelvin","Jhonatan"};

int i = 0;
for (Lavador L : lavadores) {
    L.muExterna    = p[i][0];
    L.sigmaExterna = p[i][1];
    L.muInterna    = p[i][2];
    L.sigmaInterna = p[i][3];
    L.nome         = nomes[i];
    i++;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1785935138332</Id>
					<Name><![CDATA[mediaEspera]]></Name>
					<X>830</X><Y>630</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[dia]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[return nEspera[dia] > 0 ? somaEspera[dia] / nEspera[dia] : 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Lavador]]></ReturnType>
					<Id>1785990264525</Id>
					<Name><![CDATA[sortearLavador]]></Name>
					<X>830</X><Y>660</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double[] w = {73, 92, 101, 114, 117, 96, 117, 52, 44};
double soma = 0;
for (double x : w) soma += x;
double r = uniform(0, soma);
double acc = 0;
int alvo = 0;
for (int i = 0; i < w.length; i++) {
    acc += w[i];
    if (r < acc) { alvo = i; break; }
}
int k = 0;
for (Lavador L : lavadores) {
    if (k == alvo) return L;
    k++;
}
return null;]]></Body>
				</Function>
			</Functions>
