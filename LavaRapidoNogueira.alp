					<Text><![CDATA[text]]></Text>
					<TextCode><![CDATA["Semanas: " + String.format("%.1f", time()/10080.0)
   + "\nChegadas médias/dia  (alvo)"
   + "\nSeg: " + String.format("%.2f", chegadosDia[2]/Math.max(1.0, time()/10080.0)) + "  (2.47)"
   + "\nTer: " + String.format("%.2f", chegadosDia[3]/Math.max(1.0, time()/10080.0)) + "  (2.90)"
   + "\nQua: " + String.format("%.2f", chegadosDia[4]/Math.max(1.0, time()/10080.0)) + "  (3.43)"
   + "\nQui: " + String.format("%.2f", chegadosDia[5]/Math.max(1.0, time()/10080.0)) + "  (4.45)"
   + "\nSex: " + String.format("%.2f", chegadosDia[6]/Math.max(1.0, time()/10080.0)) + "  (5.32)"
   + "\nSáb: " + String.format("%.2f", chegadosDia[7]/Math.max(1.0, time()/10080.0)) + "  (7.97)"]]></TextCode>
					<Font>
